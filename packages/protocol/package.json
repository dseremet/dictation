{
  "name": "@ditactic/dictation-protocol",
  "version": "0.1.0",
  "description": "Message protocol shared by @ditactic/dictation-vue and @ditactic/dictation-react-native for recording audio natively from a WebView.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dseremet/dictation.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  }
}
