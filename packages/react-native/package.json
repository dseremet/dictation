{
  "name": "@ditactic/dictation-react-native",
  "version": "0.1.0",
  "description": "Native dictation recorder (expo-audio) and WebView bridge for @ditactic/dictation-vue pages running inside a React Native / Expo shell.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ditactic/dictation-protocol": "^0.1.0"
  },
  "peerDependencies": {
    "expo-audio": ">=1.0.0",
    "expo-file-system": ">=19.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.76.0",
    "react-native-webview": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "~19.1.0",
    "babel-jest": "^29.7.0",
    "expo": "~54.0.0",
    "expo-audio": "~1.0.0",
    "expo-file-system": "~19.0.0",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "expo",
    "expo-audio",
    "react-native",
    "webview",
    "whisper"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/diTactic-Media/dictation.git",
    "directory": "packages/react-native"
  },
  "publishConfig": {
    "access": "public"
  }
