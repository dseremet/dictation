# Copy to .env next to docker-compose.example.yml. All variables are optional.

# Model: alias (turbo | large-v3 | medium | small | base | tiny), a HF CTranslate2 repo,
# or a directory under the /models volume.
ASR_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
ASR_DEVICE=auto              # auto | cpu | cuda
ASR_COMPUTE_TYPE=int8        # int8 on CPU, float16 on GPU; falls back automatically
ASR_CPU_THREADS=0            # 0 = CTranslate2 default (all cores)
ASR_NUM_WORKERS=1
ASR_MAX_CONCURRENCY=1        # 1 on 8 vCPU, 2 on 16 vCPU
ASR_QUEUE_DEPTH=4            # requests waiting for a slot before 503
ASR_REQUEST_TIMEOUT_S=600

# Comma-separated bearer tokens. Empty = no auth (only for isolated networks).
ASR_API_KEYS=change-me-long-random-token

ASR_DEFAULT_LANGUAGE=auto    # auto | bs | hr | sr
ASR_DECODE_LANG_MAP=bs:hr    # decode Bosnian with the Croatian token (better Whisper coverage)
ASR_MAX_UPLOAD_MB=50
ASR_MAX_AUDIO_SECONDS=600
ASR_BEAM_SIZE=5
ASR_DOCS_ENABLED=false       # Swagger UI at /docs
ASR_LOG_LEVEL=info

# Offline after the first start (weights cached in the /models volume).
HF_HUB_OFFLINE=0
HF_HUB_DISABLE_TELEMETRY=1
